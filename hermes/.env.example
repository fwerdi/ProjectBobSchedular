# ===== Hermes configuration =====
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real .env to git.

# HTTP server port (Bob UI + REST API)
PORT=3000

# Secret shared between Bob UI and Hermes API.
# Any non-empty string. Bob sends it in the "x-api-key" header.
API_KEY=change-me-to-a-long-random-string

# ---- Database ----
# If set, Hermes uses PostgreSQL. If empty, it uses a local SQLite file.
DATABASE_URL=

# ---- Google Calendar ----
# Path to the service-account JSON key file (relative to hermes/ or absolute).
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Or paste the whole JSON here instead of a file (useful for cloud hosts).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar id to write events into (usually your gmail address).
# SHARE that calendar with the service account email (see README).
GOOGLE_CALENDAR_ID=
# Timezone used for calendar events (IANA name).
TIMEZONE=Asia/Jakarta
