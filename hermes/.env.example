# ===== Hermes configuration =====
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real .env to git.

# HTTP server port (Bob UI + REST API)
PORT=3000

# Secret shared between Bob UI and Hermes API.
# Any non-empty string. Bob sends it in the "x-api-key" header.
API_KEY=change-me-to-a-long-random-string

# ---- OpenRouter (LLM) ----
OPENROUTER_API_KEY=
# Model used to parse free-text into a structured task.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Your personal chat id (where notifications are sent).
TELEGRAM_CHAT_ID=

# ---- Google Calendar ----
# Path to the service-account JSON key file (relative to hermes/ or absolute).
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# The calendar id to write events into.
# For your main calendar this is usually your gmail address.
# You must SHARE that calendar with the service account email (see README).
GOOGLE_CALENDAR_ID=
# Timezone used for calendar events (IANA name).
TIMEZONE=Asia/Jakarta
